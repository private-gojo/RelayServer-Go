load_module /usr/lib/nginx/modules/ngx_stream_module.so;

worker_processes auto;
worker_rlimit_nofile 16384;
error_log /dev/stderr warn;

events {
    worker_connections 8192;
}

stream {
    log_format stream_diag escape=json
        '{ "severity":"INFO", "component":"nginx-stream", "event":"connection_closed", '
        '"time":"$time_iso8601", "connection":"$connection", "remote":"$remote_addr:$remote_port", '
        '"status":"$status", "session_time":"$session_time", '
        '"upstream_connect_time":"$upstream_connect_time", '
        '"bytes_sent":"$bytes_sent", "bytes_received":"$bytes_received", '
        '"upstream":"$upstream_addr" }';
    access_log /dev/stdout stream_diag;

    server {
        listen __PORT__;

        proxy_pass 127.0.0.1:8081;
        proxy_timeout 3600s;
        proxy_connect_timeout 5s;
        proxy_buffer_size 128k;
        proxy_socket_keepalive on;
    }
}
